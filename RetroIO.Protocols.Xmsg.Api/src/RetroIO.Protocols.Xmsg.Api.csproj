<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RetroIO.Protocols.Xmsg.Api: the USER-FRIENDLY layer. It models the XMSG programming interface exactly as the
    official manual describes it (ND-60.164.3 EN COSMOS Programmer Guide) - tasks, ports, magic
    numbers, message buffers, the XF* function set (appendix A), the XROUT services (appendix B)
    and the server/client model (chapter 4).

    HARD RULE: this project owns NO wire bytes. Envelope/sequence/ACK behaviour stays in
    RetroIO.Protocols.Xmsg; anything here that starts computing a Counter or a channel byte is a layering
    leak. The only ProjectReference allowed is RetroIO.Protocols.Xmsg.
  -->
  <PropertyGroup>
    <PackageId>RetroIO.Protocols.Xmsg.Api</PackageId>
    <AssemblyName>RetroIO.Protocols.Xmsg.Api</AssemblyName>
    <RootNamespace>RetroIO.Protocols.Xmsg.Api</RootNamespace>
    <Description>The XMSG kernel API (XMSG monitor calls) and the RR request-response client/server model, in process.</Description>
    <PackageTags>retroio;xmsg;xmsg.api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroIO.Protocols.Xmsg\src\RetroIO.Protocols.Xmsg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
