    <AssemblyName>RetroIO.Storage.Core</AssemblyName>
    <RootNamespace>RetroIO.Storage.Core</RootNamespace>
    <Description>Core interfaces and types of RetroIO: URN-addressed volumes, streams and the driver contracts every storage backend implements.</Description>
    <PackageTags>retroio;retrofs;retrofs.core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
