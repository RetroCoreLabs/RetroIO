<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RetroIO.Tests</AssemblyName>
    <RootNamespace>RetroIO.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Reads process command lines so AzuriteSupport can stop the emulator IT started and no
         other. Windows-only by nature; the code guards on OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroIO.Storage.Core\src\RetroIO.Storage.Core.csproj" />
    <ProjectReference Include="..\..\RetroIO.Storage.Local\src\RetroIO.Storage.Local.csproj" />
    <ProjectReference Include="..\..\RetroIO.Storage.Ndfs\src\RetroIO.Storage.Ndfs.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Tnfs\src\RetroIO.Protocols.Tnfs.csproj" />
    <ProjectReference Include="..\..\RetroIO.Storage.Providers\src\RetroIO.Storage.Providers.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Econet\src\RetroIO.Protocols.Econet.csproj" />
    <ProjectReference Include="..\..\RetroIO.Identity\src\RetroIO.Identity.csproj" />
    <ProjectReference Include="..\..\RetroIO.Server.Hosting\src\RetroIO.Server.Hosting.csproj" />
    <ProjectReference Include="..\..\RetroIO.Storage.Utilities\src\RetroIO.Storage.Utilities.csproj" />
    <ProjectReference Include="..\..\RetroIO.Storage.Azure\src\RetroIO.Storage.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real SINTRAN III K pack captured 2026-08-02 with 201 users and a THRICE-relocated
         overflow object block. Gzipped: 78 MB raw, 2.7 MB compressed. Our own writer never
         relocates, so no synthetic image can exercise the file-numbering rule this pins down. -->
    <Content Include="TestData\BIGDISK0-K-201users.img.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>TestData\BIGDISK0-K-201users.img.gz</TargetPath>
    </Content>
  </ItemGroup>

</Project>
