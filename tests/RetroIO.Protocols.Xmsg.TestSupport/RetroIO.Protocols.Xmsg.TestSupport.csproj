<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared helpers for the test projects ONLY. Nothing here ships in a production assembly.

    It exists because the same FromHex was hand-written 11 times across five test projects, in
    THREE different behaviours - strip nothing, strip spaces, strip spaces and newlines. A capture
    pasted with a line break parsed in one project and threw in another, purely by which copy the
    file happened to sit next to.

    IsTestProject is deliberately NOT set: this carries no tests of its own, and marking it as a
    test project makes the runner scan it for good.
  -->

  <PropertyGroup>
    <AssemblyName>RetroIO.Protocols.Xmsg.TestSupport</AssemblyName>
    <RootNamespace>RetroIO.Protocols.Xmsg.TestSupport</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Says out loud what the comment above only intended. This project sits under tests/, and
      eng/build/tests.Directory.Build.props sets IsTestProject=true for everything there - so
      without this line the runner scans a library that carries no tests, its testhost exits
      with an error, and `dotnet test` returns non-zero even when every test passed. A property
      set in the csproj wins, because Directory.Build.props is imported before it.
    -->
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
