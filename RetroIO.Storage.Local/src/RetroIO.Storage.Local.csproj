<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RetroIO.Storage.Local</PackageId>
    <AssemblyName>RetroIO.Storage.Local</AssemblyName>
    <RootNamespace>RetroIO.Storage.Local</RootNamespace>
    <Description>Local filesystem backend for RetroIO: direct access to disk images including D64, NDFS, HFS and others, with partition detection.</Description>
    <PackageTags>retroio;retrofs;retrofs.local</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroIO.Storage.Core\src\RetroIO.Storage.Core.csproj" />
    <ProjectReference Include="..\..\RetroIO.Storage.Utilities\src\RetroIO.Storage.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
