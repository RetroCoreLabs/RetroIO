<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RetroIO.Protocols.X25.Common</PackageId>
    <AssemblyName>RetroIO.Protocols.X25.Common</AssemblyName>
    <RootNamespace>RetroIO.Protocols.X25.Common</RootNamespace>
    <Description>Shared helpers of the X.25 family: logger, INI config reader, LAPB timer interfaces.</Description>
    <PackageTags>retroio;x25;x25emulator.common</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
