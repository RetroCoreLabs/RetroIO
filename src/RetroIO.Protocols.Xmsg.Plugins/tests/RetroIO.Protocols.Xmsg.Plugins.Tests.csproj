    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\RetroIO.Protocols.Xmsg.Plugins.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Xmsg.Plugins.Client\src\RetroIO.Protocols.Xmsg.Plugins.Client.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Xmsg.Chat\src\RetroIO.Protocols.Xmsg.Chat.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Xmsg.Hub\src\RetroIO.Protocols.Xmsg.Hub.csproj" />
  </ItemGroup>

</Project>
