<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RetroIO.Protocols.Xmsg</PackageId>
    <AssemblyName>RetroIO.Protocols.Xmsg</AssemblyName>
    <RootNamespace>RetroIO.Protocols.Xmsg</RootNamespace>
    <Description>SINTRAN XMSG wire protocol: frame codec, envelope, COSMOS file-access (FA), QFORM and list-routing protocols.</Description>
    <PackageTags>retroio;xmsg;xmsg.protocol</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
