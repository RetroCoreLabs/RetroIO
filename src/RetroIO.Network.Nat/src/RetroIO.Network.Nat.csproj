<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RetroIO.Network.Nat: the built-in NAT. An emulated machine on it gets an address by DHCP,
    a gateway and a name server, and its UDP, TCP and ping reach the internet through ordinary
    host sockets, so no administrator rights are needed. Port forwards let host programs reach
    the machine. It is an IEthernetBackend (whole Ethernet frames, for an emulated network card),
    and it also takes bare IP packets, for dial-up over SLIP and RetroIO.Network.Router.

    Specifications: RFC 768 (UDP), RFC 791 (IPv4), RFC 792 (ICMP), RFC 826 (ARP), RFC 951
    (BOOTP), RFC 1035 (DNS), RFC 2131 (DHCP), RFC 4787 (NAT behaviour for UDP), RFC 9293 (TCP).
  -->
  <PropertyGroup>
    <PackageId>RetroIO.Network.Nat</PackageId>
    <AssemblyName>RetroIO.Network.Nat</AssemblyName>
    <RootNamespace>RetroIO.Network.Nat</RootNamespace>
    <Description>The built-in NAT for emulated machines: DHCP, a gateway and a name server, UDP, TCP and ping to the internet through ordinary host sockets, and port forwards in. Takes Ethernet frames or bare IP packets.</Description>
    <PackageTags>retroio;nat;network;ethernet;dhcp;slip;emulation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RetroIO.Network.Nat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroIO.Network.Ethernet\src\RetroIO.Network.Ethernet.csproj" />
  </ItemGroup>
</Project>
