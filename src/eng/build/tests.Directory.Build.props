<Project>
  <!-- Test defaults. No test-framework references here: RetroIO has NUnit projects, xunit projects and one with both. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Shared run settings (a test's output is shown once). A project that names its own file in its
         csproj replaces this one, and must then carry the same ConsoleOut setting itself. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
