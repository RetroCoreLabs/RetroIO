<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Switch domain core: config records + loader + (later) the transport-agnostic switching engine.
    Depends on the generic Common (IniConfig) and Routing (X121 route model) leaves. Transport-specific
    port implementations and the management surfaces live in separate assemblies so a headless or test
    switch can use this core alone. See docs/SWITCH_ARCHITECTURE.md.
  -->
  <PropertyGroup>
    <PackageId>RetroIO.Protocols.X25.Switch</PackageId>
    <AssemblyName>RetroIO.Protocols.X25.Switch</AssemblyName>
    <RootNamespace>RetroIO.Protocols.X25.Switch</RootNamespace>
    <Description>The X.25 switch core: switch node, call switching, port abstraction and configuration loader.</Description>
    <PackageTags>retroio;x25;x25emulator.switch.core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroIO.Protocols.X25.Common\src\RetroIO.Protocols.X25.Common.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.X25.Routing\src\RetroIO.Protocols.X25.Routing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
