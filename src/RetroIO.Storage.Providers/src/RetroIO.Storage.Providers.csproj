<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RetroIO.Storage.Providers</PackageId>
    <AssemblyName>RetroIO.Storage.Providers</AssemblyName>
    <RootNamespace>RetroIO.Storage.Providers</RootNamespace>
    <Description>Volume providers for RetroIO: FTP, SFTP, TNFS and the native filesystem.</Description>
    <PackageTags>retroio;retrofs;retrofs.providers</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RetroIO.Storage.Core\src\RetroIO.Storage.Core.csproj" />
    <ProjectReference Include="..\..\RetroIO.Server.Core\src\RetroIO.Server.Core.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Econet\src\RetroIO.Protocols.Econet.csproj" />
    <ProjectReference Include="..\..\RetroIO.Protocols.Tnfs\src\RetroIO.Protocols.Tnfs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RetroIO.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
