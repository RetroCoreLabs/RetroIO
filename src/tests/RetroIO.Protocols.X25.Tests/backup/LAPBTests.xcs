        [Test]
        public void ProcessPendingTransmissions_WhenRemoteBusy_ShouldNotSend()
        {
            // Arrange
            _lapb.SetState(LAPB.State.CONNECTED);
            _lapb.SetRemoteBusy(true);
            byte[] data = { 0x01, 0x02, 0x03 };
            _lapb.QueueData(data, 3);

            // Act
            _lapb.ProcessPendingTransmissions();

            // Assert
            Assert.That(_sentFrames.Count, Is.EqualTo(0)); // No frames sent
            Assert.That(_lapb.GetTxQueueCount(), Is.EqualTo(1)); // Frame still queued
        }

        [Test]
        public void ProcessPendingTransmissions_WhenWindowFull_ShouldNotSend()
        {
            // Arrange
            _lapb.SetState(LAPB.State.CONNECTED);
            _lapb.SetVS(7); // Window full
            _lapb.SetVR(0);
            byte[] data = { 0x01, 0x02, 0x03 };
            _lapb.QueueData(data, 3);

            // Act
            _lapb.ProcessPendingTransmissions();

            // Assert
            Assert.That(_sentFrames.Count, Is.EqualTo(0)); // No frames sent
            Assert.That(_lapb.GetTxQueueCount(), Is.EqualTo(1)); // Frame still queued
        }

        [Test]
        public void SendSFrame_RNR_ShouldConstructCorrectControlField()
        {
            // Arrange
            _lapb.SetState(LAPB.State.CONNECTED);
            _lapb.SetVR(2);

            // Act
            _lapb.SendSFrame(0x05, false, false); // RNR

            // Assert
            Assert.That(_sentFrames.Count, Is.EqualTo(1));
            
            byte[] frame = _sentFrames[0];
            Assert.That(frame[0], Is.EqualTo(0x01)); // Address
            Assert.That(frame[1], Is.EqualTo(0x45)); // Control: 0x05 | (2<<5) = 0x45
        }

        [Test]
        public void SendSFrame_REJ_ShouldConstructCorrectControlField()
        {
            // Arrange
            _lapb.SetState(LAPB.State.CONNECTED);
            _lapb.SetVR(1);

            // Act
            _lapb.SendSFrame(0x09, false, false); // REJ

            // Assert
            Assert.That(_sentFrames.Count, Is.EqualTo(1));
            
            byte[] frame = _sentFrames[0];
            Assert.That(frame[0], Is.EqualTo(0x01)); // Address
            Assert.That(frame[1], Is.EqualTo(0x29)); // Control: 0x09 | (1<<5) = 0x29
        }

        [Test]
        public void SendUFrame_SABM_ShouldConstructCorrectControlField()
        {
            // Act
            _lapb.SendUFrame(0x2F, true, 200); // SABM with Final bit and machine ID

            // Assert
            Assert.That(_sentFrames.Count, Is.EqualTo(1));
            
            byte[] frame = _sentFrames[0];
            Assert.That(frame[0], Is.EqualTo(0x01)); // Address
            Assert.That(frame[1], Is.EqualTo(0x3F)); // Control: 0x2F | 0x10 = 0x3F
            Assert.That(frame[2], Is.EqualTo(0x00)); // Machine ID high byte
            Assert.That(frame[3], Is.EqualTo(0xC8)); // Machine ID low byte
        }

        [Test]
        public void SendUFrame_DISC_ShouldConstructCorrectControlField()
        {
            // Act
            _lapb.SendUFrame(0x43, true); // DISC with Final bit

            // Assert
            Assert.That(_sentFrames.Count, Is.EqualTo(1));
            
            byte[] frame = _sentFrames[0];
            Assert.That(frame[0], Is.EqualTo(0x01)); // Address
            Assert.That(frame[1], Is.EqualTo(0x53)); // Control: 0x43 | 0x10 = 0x53
        }

