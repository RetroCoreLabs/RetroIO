        [Test]
        public void ProcessUnnumberedFrame_UnknownType_ShouldLogWarning()
        {
            // Arrange
            byte[] unknownFrame = { 0x01, 0xFF, 0x00, 0x00 }; // Unknown U-frame type + FCS

            // Act
            _lapb.ReceiveFrame(unknownFrame, 4);

            // Assert
            Assert.That(_mockLogger.WarningMessages.Count, Is.GreaterThan(0));
            Assert.That(_mockLogger.WarningMessages.Any(m => m.Contains("Unknown U-frame")));
        }

