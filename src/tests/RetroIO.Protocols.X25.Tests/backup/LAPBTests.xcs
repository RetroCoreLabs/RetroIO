        [Test]
        public void GetState_ShouldReturnCorrectStateString()
        {
            // Test different states
            _lapb.SetState(LAPB.State.DISCONNECTED);
            Assert.That(_lapb.GetState(), Is.EqualTo("DISCONNECTED"));

            _lapb.SetState(LAPB.State.LINK_SETUP);
            Assert.That(_lapb.GetState(), Is.EqualTo("LINK_SETUP"));

            _lapb.SetState(LAPB.State.CONNECTED);
            Assert.That(_lapb.GetState(), Is.EqualTo("CONNECTED"));

            _lapb.SetState(LAPB.State.DISCONNECTING);
            Assert.That(_lapb.GetState(), Is.EqualTo("DISCONNECTING"));
        }

        [Test]
        public void ProcessInformationFrame_ExtendedModeSequenceNumbers_ShouldWorkCorrectly()
        {
            // Arrange
            _lapb.SetState(LAPB.State.CONNECTED);
            // Process SABME to set extended mode
            byte[] sabmeFrame = { 0x01, 0x6F, 0x00, 0x64 }; // SABME with machine ID 100
            _lapb.ReceiveFrame(sabmeFrame, 4);
            _sentFrames.Clear(); // Clear the UA response
            
            _lapb.SetVR(127); // At modulo boundary
            byte[] iFrame = { 0x01, 0x00, 0x00, 0x00 }; // I-frame with N(S)=0, N(R)=0 + FCS

            // Act
            _lapb.ReceiveFrame(iFrame, 4);

            // Assert
            Assert.That(_lapb.VR, Is.EqualTo(0)); // Should wrap around to 0
        }

        [Test]
        public void ProcessInformationFrame_ExtendedModeControlField_ShouldUse7Bits()
        {
            // Arrange
            _lapb.SetState(LAPB.State.CONNECTED);
            // Process SABME to set extended mode
            byte[] sabmeFrame = { 0x01, 0x6F, 0x00, 0x64 }; // SABME with machine ID 100
            _lapb.ReceiveFrame(sabmeFrame, 4);
            _sentFrames.Clear(); // Clear the UA response
            
            _lapb.SetVR(0);
            // Extended mode I-frame: N(R) in bits 5-1, N(S) in bits 13-9
            byte[] iFrame = { 0x01, 0x00, 0x00, 0x00, 0x00 }; // Extended I-frame with N(S)=0, N(R)=0 + FCS

            // Act
            _lapb.ReceiveFrame(iFrame, 5);

            // Assert
            Assert.That(_lapb.VR, Is.EqualTo(1));
        }

        [Test]
        public void QueueData_MultiplePackets_ShouldMaintainOrder()
        {
            // Arrange
            byte[] data1 = { 0x01 };
            byte[] data2 = { 0x02 };
            byte[] data3 = { 0x03 };

            // Act
            _lapb.QueueData(data1, 1);
            _lapb.QueueData(data2, 1);
            _lapb.QueueData(data3, 1);

            // Assert
            Assert.That(_lapb.GetRxQueueCount(), Is.EqualTo(3));

            // Process all data
            _lapb.Process();
            Assert.That(_sentData.Count, Is.EqualTo(3));
            Assert.That(_sentData[0], Is.EqualTo(data1));
            Assert.That(_sentData[1], Is.EqualTo(data2));
            Assert.That(_sentData[2], Is.EqualTo(data3));
        }
    }
}
