<Project>

  <!--
    The 2026-08-04 header/sub-header boundary correction left a deliberate set of [Obsolete]
    COMPATIBILITY VIEWS (SintranHeader.ProtocolId / .Counter, XmsgDataFields.ControlService /
    .Pad / .UserDataLength / .Payload, XmsgFrame.ControlService). They compute the old view over
    the one correct stored model so the ~85 existing call sites keep compiling and passing.

    Every project sets TreatWarningsAsErrors, so the obsolete-use warnings would break the build
    outright. They are demoted to WARNINGS - deliberately still visible, so `dotnet build` prints
    a live worklist of what has yet to migrate off the facade. Do NOT change this to NoWarn: that
    would hide the worklist. Remove this file once the last CS0618 is gone.
  -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0618;CS0612</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
